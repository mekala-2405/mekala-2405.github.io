# These are configured in the Cloudflare Pages dashboard
# (Settings > Environment variables), NOT read from this file at runtime.
# Listed here only as a reference for what functions/_middleware.ts expects.

# Google Analytics 4 Measurement ID (served to non-EU/UK visitors)
GA4_ID=G-XXXXXXXXXX

# Cloudflare Web Analytics token (cookieless, served to EU/EEA/UK visitors)
CF_BEACON_TOKEN=your_cloudflare_web_analytics_token
